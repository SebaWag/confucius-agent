# ============================================
# Confucius Agent — Configuration
# ============================================

# --- API Mode ---
# "qwen" para Qwen Cloud (submission) | "fallback" para desarrollo
API_MODE=fallback

# --- Qwen Cloud API (for submission) ---
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# --- Fallback APIs (for development/testing) ---
# Compatible with any OpenAI-compatible endpoint
FALLBACK_API_KEY=your-fallback-key
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o

# --- Databases (Docker) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
POSTGRES_DSN=postgresql://confucius:confucius_secret@localhost:5433/confucius
REDIS_URL=redis://localhost:6380/0

# --- Memory Tuning (optional) ---
# MENTAL_MODELS_TOP_K=5
# MENTAL_MODELS_SCORE_THRESHOLD=0.7
# OBSERVATIONS_RECENCY_DAYS=30
# RAW_FACTS_TTL=3600
