# ============================================
# Confucius Agent — Configuration
# ============================================

# --- Qwen Cloud API (for submission) ---
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# --- Fallback APIs (for development/testing) ---
# Compatible with any OpenAI-compatible endpoint
FALLBACK_API_KEY=your-fallback-key
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o

# --- Databases ---
CHROMA_PERSIST_DIR=./data/chroma
POSTGRES_DSN=postgresql://user:pass@localhost:5432/confucius
REDIS_URL=redis://localhost:6379/0
